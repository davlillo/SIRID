# PostgreSQL
POSTGRES_USER=sirid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sirid
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sirid:change-me@postgres:5432/sirid

# Aplicacion
ENVIRONMENT=development
COMPLEX_TIMEZONE=America/Guatemala
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
# URL usada por Next.js durante SSR dentro de la red de Docker.
INTERNAL_API_URL=http://backend:8000/v1
NEXT_PUBLIC_APP_VERSION=1.0.0
SEED_ON_START=true

# Sesion propia. En produccion usar un valor largo y aleatorio de un gestor de secretos.
JWT_SECRET=change-me-with-a-long-random-value

# Google Identity. El mismo Client ID se usa en backend y frontend.
GOOGLE_CLIENT_ID=

# Acceso local sin Google. Mantener en false fuera del desarrollo local.
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_DEV_AUTH_ENABLED=false

# Cuenta(s) de bootstrap para el administrador del sistema, separadas por coma.
ADMIN_EMAILS=

# Gmail SMTP con contraseña de aplicacion, nunca la contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SIRID
# Also accepts SMTP_USER, SMTP_PASS, FROM_EMAIL and FROM_NAME.
# Optional tenant SMTP: independent Fernet key; retain it to decrypt saved credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEY=
# Operator-approved SMTP hosts; tenant configuration cannot target arbitrary servers.
SMTP_ALLOWED_HOSTS=smtp.gmail.com,smtp.office365.com,smtp.mail.yahoo.com
