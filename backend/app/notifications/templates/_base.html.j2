{# Inline styles and table layout keep the messages readable in email clients. #}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ organization_name | default('SIRID', true) }} · SIRID</title>
  <style>
    @media only screen and (max-width:600px) {
      .email-outer { padding:16px 10px !important; }
      .email-content { padding:26px 22px !important; }
      .email-heading { font-size:30px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f0ebe2;font-family:Arial,Helvetica,sans-serif;color:#191817;-webkit-text-size-adjust:100%;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">{% block preheader %}Una actualización de {{ organization_name | default('SIRID', true) }} para {{ customer_name }}.{% endblock %}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f0ebe2;">
    <tr><td class="email-outer" align="center" style="padding:40px 16px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#f7f3ea;border:1px solid #dcd2c4;border-radius:16px;overflow:hidden;">
        <tr><td style="background:{{ header_color | default('#191817') }};padding:26px 34px;border-bottom:5px solid #c65f45;">
          <p style="margin:0;font-size:26px;font-weight:700;letter-spacing:-1px;color:#f7f3ea;">SIRID<span style="color:#e69b80;">.</span></p>
          <p style="margin:8px 0 0;font-family:'Courier New',monospace;font-size:10px;letter-spacing:1.6px;color:#e8d8be;">{{ header_label | default('RESERVAS / SU ORGANIZACIÓN') }}</p>
          <p style="margin:14px 0 0;font-size:14px;line-height:1.5;color:#f7f3ea;">{{ organization_name | default('SIRID · Reserva deportiva', true) }}</p>
        </td></tr>
        {% if is_preview | default(false) %}
        <tr><td style="padding:14px 34px;background:#e8d8be;color:#49352c;font-size:12px;line-height:1.6;">
          <strong>PRUEBA SMTP · DATOS DE DEMOSTRACIÓN</strong><br>Este mensaje no crea reservas, no confirma pagos ni activa cuentas.
        </td></tr>
        {% endif %}
        <tr><td class="email-content" style="padding:36px 34px;">
          <h1 class="email-heading" style="margin:0;font-size:34px;line-height:1.15;letter-spacing:-1px;">{% block title %}{% endblock %}</h1>
          <p style="margin:24px 0 10px;font-size:16px;line-height:1.7;">Hola, <strong>{{ customer_name }}</strong>:</p>
          <div style="font-size:15px;line-height:1.8;color:#575049;">{% block intro %}{% endblock %}</div>
          {% block details %}
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:26px;border:1px solid #dcd2c4;background:#ffffff;">
            {% for label, value in [
              ('Instalación', facility_name), ('Ubicación', facility_location),
              ('Fecha', date_label), ('Horario', time_label),
              ('Importe de la reserva', amount), ('Estado', status_label | default(status))
            ] %}
            <tr>
              <td style="padding:13px 16px;width:38%;font-family:'Courier New',monospace;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#65705a;border-bottom:1px solid #eee6d9;">{{ label }}</td>
              <td style="padding:13px 16px;font-size:14px;font-weight:600;line-height:1.5;color:#191817;border-bottom:1px solid #eee6d9;overflow-wrap:anywhere;">{{ value }}</td>
            </tr>
            {% endfor %}
          </table>
          {% endblock %}
          {% block extra %}{% endblock %}
          {% if not is_preview | default(false) %}
            {% block action %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:26px;">
              <tr><td align="center" bgcolor="#924e37" style="background:#924e37;border-radius:9px;mso-padding-alt:17px 22px;">
                <a href="{{ frontend_url }}/mis-reservas" style="display:block;padding:17px 22px;color:#ffffff;font-size:15px;font-weight:700;line-height:1.5;text-decoration:none;">Ver mis reservas &rarr;</a>
              </td></tr>
            </table>
            <p style="margin:14px 0 0;color:#696057;font-size:12px;line-height:1.7;">Consulte el estado actualizado y las opciones disponibles desde su cuenta.</p>
            {% endblock %}
          {% else %}
            <p style="margin:24px 0 0;padding-top:18px;border-top:1px solid #dcd2c4;font-size:12px;line-height:1.7;color:#696057;">Vista previa: los botones de acción están deshabilitados en este correo de prueba.</p>
          {% endif %}
        </td></tr>
        <tr><td style="padding:22px 34px;background:#eee6d9;border-top:1px solid #dcd2c4;">
          {% block footer %}
          <p style="margin:0;color:#49352c;font-family:'Courier New',monospace;font-size:11px;line-height:1.7;letter-spacing:1px;">RESERVA {{ reservation_id[:8] | upper }} · SIRID</p>
          <p style="margin:8px 0 0;color:#696057;font-size:11px;line-height:1.7;">Mensaje de {{ organization_name | default('su organización', true) }}. Para consultas sobre su reserva, contacte al encargado de la organización.</p>
          {% endblock %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
