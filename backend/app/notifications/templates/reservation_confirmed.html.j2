{% extends "_base.html.j2" %}

{% block preheader %}Todo listo, {{ customer_name }}: {{ facility_name }} le espera el {{ date_label }} a las {{ time_label }}.{% endblock %}
{% block title %}Todo listo para su próxima visita.{% endblock %}

{% block intro %}
  El encargado de <strong>{{ organization_name }}</strong> confirmó su solicitud.
  <strong>{{ facility_name }}</strong> queda reservado a su nombre para la fecha y el horario indicados.
{% endblock %}

{% block extra %}
  <p style="margin:22px 0 0;padding:16px 18px;background:#e6eadf;border-left:3px solid #65705a;font-size:13px;line-height:1.8;color:#394331;">
    <strong>Prepare su visita.</strong> Preséntese unos minutos antes en {{ facility_location }}.
    Si no puede asistir, cancele desde su cuenta para liberar el espacio.
  </p>
{% endblock %}
